# Bootstrap first platform admin (run once): npm run create-admin
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

MONGODB_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=
PORT=5000
CLIENT_URL=http://localhost:5173
# Production example (comma-separated for multiple origins):
# CLIENT_URL=https://frontend-six-nu-69.vercel.app,http://localhost:5173
NODE_ENV=development

# Google OAuth (optional — required for Continue with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Email (development uses console logging by default)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@grace-ai.local
EMAIL_API_KEY=

# SMTP (when EMAIL_PROVIDER=smtp)
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_SECURE=false

# Frontend — copy frontend/.env.example to frontend/.env
# Production example:
# VITE_API_URL=https://grace-ai-3.onrender.com/api
# VITE_API_ORIGIN=https://grace-ai-3.onrender.com
# VITE_GOOGLE_CLIENT_ID=

# Example Atlas URI format (do not commit real credentials):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
